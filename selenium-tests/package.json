{
  "name": "selenium-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Selenium WebDriver e2e tests for hakaton site",
  "scripts": {
    "test": "jest --runInBand",
    "test:verbose": "jest --runInBand --verbose",
    "test:headed": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "chromedriver": "^136.0.0",
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.44.0"
  }
}
